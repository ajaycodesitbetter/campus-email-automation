# Local development environment for user management
NODE_ENV=development

# Production database URL (replace with your actual Neon database URL)
# Get this from your Neon console dashboard
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require&channel_binding=require

# Session secret for local testing
SESSION_SECRET=your-secret-key-here

# Gmail configuration for email sending
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-app-password
EMAIL_DAILY_LIMIT=150

# API Base URL for frontend
VITE_API_BASE_URL=https://campus-email-automation-production.up.railway.app

